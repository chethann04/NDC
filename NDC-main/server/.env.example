PORT=5000
NODE_ENV=development
# Frontend URL (e.g. http://localhost:5173 for local dev, or https://your-app.vercel.app for deployed testing)
CLIENT_URL=https://ndc-three.vercel.app
JWT_SECRET=super_secret_ndc_jwt_key_2026_mce_auth_token_string
JWT_EXPIRES_IN=7d

# Express Reverse Proxy Configuration (Render / Cloud Load Balancer)
# Default is 1 (trusts 1 hop from Render ingress proxy). Override if using Cloudflare -> Render (set to 2).
TRUST_PROXY=1

# Supabase PostgreSQL Connection Strings (Transaction pooler for DATABASE_URL, Session/Direct for DIRECT_URL)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------------
# EMAIL CONFIGURATION (Google Apps Script HTTPS Port 443)
# -------------------------------------------------------------

# Primary Production Provider: Google Apps Script Web App
# - Dispatches emails via Google MailApp.sendEmail() over HTTPS (Port 443).
# - Bypasses Render Free outbound SMTP blocks (ENETUNREACH on ports 25, 465, 587).
# - Can send to ANY dynamic student recipient address (@gmail.com, @college.edu.in, etc.)
# - Does not require a custom domain, SPF/DKIM DNS records, or credit card.
# - Quotas: 100 emails/day (Personal @gmail.com) or 1,500 emails/day (Google Workspace).
EMAIL_PROVIDER=apps_script
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id_here/exec
GOOGLE_APPS_SCRIPT_SECRET=your_super_secret_apps_script_token_here
EMAIL_SENDER_NAME="MCE No Due Portal"

# Legacy aliases supported for backward compatibility:
# APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id_here/exec
# APPS_SCRIPT_SECRET=your_super_secret_apps_script_token_here

# Optional Secondary Provider: Resend HTTPS Email API (Port 443)
# - Note: Resend sandbox mode only delivers to verified account owner email.
# - To send to all students, a custom domain must be verified at https://resend.com/domains
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_live_resend_api_key_here
# EMAIL_FROM="MCE No Due Portal <noreply@yourdomain.edu.in>"

# NOTE: Direct Gmail SMTP (nodemailer) has been REMOVED from the production path.
# Render Free instances block outbound SMTP ports (25, 465, 587) at the firewall layer,
# causing ENETUNREACH. All production email delivery uses Google Apps Script HTTPS (Port 443).
